# Copie para .env e preencha com valores locais. Nunca versione o .env.
POSTGRES_SUPERUSER_PASSWORD=
MIGRATOR_PASSWORD=
APP_PASSWORD=
POSTGRES_PORT=54329

# URLs usadas pela aplicação e pelos testes (preencha as senhas acima)
DATABASE_URL=postgres://reparo_app:APP_PASSWORD@127.0.0.1:54329/reparo360_dev
MIGRATION_DATABASE_URL=postgres://reparo_migrator:MIGRATOR_PASSWORD@127.0.0.1:54329/reparo360_dev
TEST_DATABASE_URL=postgres://reparo_app:APP_PASSWORD@127.0.0.1:54329/reparo360_test
TEST_MIGRATION_DATABASE_URL=postgres://reparo_migrator:MIGRATOR_PASSWORD@127.0.0.1:54329/reparo360_test

# API
COOKIE_SECURE=true
ALLOW_PUBLIC_ONBOARDING=false

# Pasta privada dos anexos. Use um caminho FORA do OneDrive e de qualquer pasta servida.
STORAGE_DIR=C:/caminho/fora/do/onedrive/reparo360-storage

# Aprovação remota do orçamento por código no e-mail do cliente (P-03). Opcional: sem SMTP_URL só existe a aprovação presencial.
# SMTP_URL=smtp://usuario:senha@servidor-smtp:587
# MAIL_FROM="Nome da Assistência <nao-responda@seu-dominio>"
# VERIFICATION_SECRET=gere-um-texto-aleatorio-com-pelo-menos-32-caracteres

# Master (administração da plataforma). Sem MASTER_ENC_KEY as rotas do Master não existem.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MASTER_ENC_KEY=

# Endereço público do sistema, usado para montar os links dos e-mails (redefinição de senha e convite). NUNCA vem da requisição.
# Obrigatório quando SMTP_URL estiver definido. Localmente: http://localhost:3000
# PUBLIC_URL=http://localhost:3000
